{
  "identifier": "theorvane-proxmox-mcp",
  "name": "Proxmox MCP",
  "version": "0.1.1",
  "author": "Theorvane",
  "authorUrl": "https://github.com/Theorvane",
  "category": "tools",
  "description": "Safety-gated MCP tools for administering Proxmox VE. The marketplace listing describes capabilities only; install the local stdio server from a checksum-verified GitHub Release archive.",
  "homepage": "https://github.com/Theorvane/proxmox-mcp",
  "icon": "https://www.proxmox.com/images/proxmox/Proxmox_logo_standard_hex_400px.png",
  "tags": ["mcp", "proxmox", "self-hosted", "virtualization", "safety"],
  "tools": [
    {
      "name": "cluster_version",
      "description": "Read cluster version.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "cluster_resources",
      "description": "List cluster resources.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": ["vm", "storage", "node"]
          }
        }
      }
    },
    {
      "name": "list_nodes",
      "description": "List nodes.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "node_status",
      "description": "Read node status.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        },
        "required": ["node"]
      }
    },
    {
      "name": "list_storage",
      "description": "List node storage.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        },
        "required": ["node"]
      }
    },
    {
      "name": "list_qemu",
      "description": "List QEMU VMs on a node.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        },
        "required": ["node"]
      }
    },
    {
      "name": "list_lxc",
      "description": "List LXC containers on a node.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          }
        },
        "required": ["node"]
      }
    },
    {
      "name": "list_tasks",
      "description": "List node tasks.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
