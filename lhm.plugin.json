        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          },
          "upid": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["node", "upid"]
      }
    },
    {
      "name": "qemu_start",
      "description": "Start a QEMU VM.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "node": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$"
          },
          "vmid": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["node", "vmid"]
      }
    },
    {
      "name": "qemu_shutdown",
